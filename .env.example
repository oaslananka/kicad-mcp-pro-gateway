# Non-secret development configuration examples for KiCad MCP Pro Companion.
# Copy to .env for local development. NEVER commit a real .env file or put
# secrets in this file — device private keys are never configured this way,
# they are generated locally and held in the platform secret store.

# Directory for local (non-secret) state: SQLite DB, checkpoints, logs.
COMPANION_DATA_DIR=

# Log verbosity: trace | debug | info | warn | error
COMPANION_LOG_LEVEL=info

# Local kicad-mcp-pro MCP Streamable HTTP endpoint. Must be loopback/local;
# the core-bridge crate refuses non-local endpoints by default.
COMPANION_CORE_BRIDGE_ENDPOINT=http://127.0.0.1:3334/mcp

# Outbound transport is disabled by default. Set this to "mock" explicitly
# only for local development/testing. There is no production cloud transport
# in this repository yet.
COMPANION_TRANSPORT_MODE=disabled

# Local IPC endpoint override (rarely needed; platform default is used
# otherwise — named pipe on Windows, Unix domain socket elsewhere).
COMPANION_IPC_ENDPOINT=
